# Secrets
.env
.env.local
.streamlit/secrets.toml

# NOTE: data/raw, data/processed and outputs/ ARE committed on purpose:
# the raw PIHPS snapshot makes results reproducible, and committed outputs
# let the dashboard run (or deploy to Streamlit Cloud) without retraining.

# Paper PDFs are copyrighted: keep locally, cite in docs/literature.md
docs/papers/*.pdf
docs/papers/text/

# Local Claude Code config
.claude/
